{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": "src",
    "outDir": "dist",
    "types": ["node"]
  },
  "include": ["src/web/server/**/*.ts", "src/web/edgeone/**/*.ts", "src/web/scf/**/*.ts", "src/main/**/*.d.ts"],
  "exclude": ["src/**/*.test.ts"]
}
